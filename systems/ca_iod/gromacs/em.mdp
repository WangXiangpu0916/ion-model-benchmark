; Energy minimization
integrator          = steep
nsteps              = 50000
emtol               = 100.0
emstep              = 0.005

; Nonbonded interactions
cutoff-scheme       = Verlet
nstlist             = 20
coulombtype         = PME
rcoulomb            = 1.0
vdwtype             = Cut-off
vdw-modifier        = Potential-shift
rvdw                = 1.0
DispCorr            = EnerPres
pbc                 = xyz

; Water remains rigid through SETTLE in the topology
constraints         = none

; Output
nstenergy           = 100
nstlog              = 100
